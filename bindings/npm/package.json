{
  "name": "@marknotes/sync",
  "version": "0.2.0",
  "license": "GPL-3.0-or-later",
  "description": "Shared sync core of the MarkNotes apps (WebAssembly)",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "recover.js",
    "index.d.ts",
    "generated/marknotes_sync.js",
    "generated/wasm-base64.js"
