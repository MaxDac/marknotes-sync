  "sideEffects": true,
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/fixtures.test.mjs test/boundary.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxDac/marknotes-sync.git",
    "directory": "bindings/npm"
  },
  "private": true
}
